"lowercase" = "malá písmena";
"Title Case" = "Každé Slovo Velkým";
"Sentence case" = "Jako věta";
"Trim whitespace" = "Odstranit mezery na okrajích";
"Single line" = "Jeden řádek";
"Plain text (no formatting)" = "Prostý text (bez formátování)";
