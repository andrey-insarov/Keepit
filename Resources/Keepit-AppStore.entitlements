<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build: App Sandbox is mandatory. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Needed to show the "open this file" and "save format to file" panels in the Viewer. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Team identifier placeholder; the Makefile fills it from the signing identity. -->
    <key>com.apple.application-identifier</key>
    <string>__TEAM_ID__.com.it.keep</string>
    <key>com.apple.developer.team-identifier</key>
    <string>__TEAM_ID__</string>
</dict>
</plist>
